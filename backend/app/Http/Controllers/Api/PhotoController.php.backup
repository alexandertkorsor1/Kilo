<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Photo;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;

class PhotoController extends Controller
{
    public function index(): JsonResponse
    {
        $photos = Photo::query()
            ->where('is_published', true)
            ->orderBy('sort_order')
            ->orderBy('created_at')
            ->get()
            ->map(function (Photo $photo) {
                return [
                    'id' => $photo->id,
                    'src' => $photo->image_path
                        ? Storage::disk('public')->url($photo->image_path)
                        : $photo->external_url,
                    'alt' => $photo->alt,
                    'title' => $photo->title,
                    'category' => $photo->category,
                    'orientation' => $photo->orientation,
                ];
            });

        return response()->json([
            'photos' => $photos,
        ]);
    }

    public function adminIndex(): JsonResponse
    {
        $photos = Photo::query()
            ->orderBy('sort_order')
            ->orderBy('created_at')
            ->get()
            ->map(function (Photo $photo) {
                return [
                    'id' => $photo->id,
                    'src' => $photo->image_path
                        ? Storage::disk('public')->url($photo->image_path)
                        : $photo->external_url,
                    'title' => $photo->title,
                    'alt' => $photo->alt,
                    'category' => $photo->category,
                    'orientation' => $photo->orientation,
                    'is_temporary' => $photo->is_temporary,
                    'is_published' => $photo->is_published,
                    'sort_order' => $photo->sort_order,
                    'created_at' => $photo->created_at,
                ];
            });

        return response()->json(['photos' => $photos]);
    }


    public function store(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'image' => ['required', 'file', 'mimes:jpg,jpeg,png,webp', 'max:10240'],
            'title' => ['required', 'string', 'min:1', 'max:150'],
            'alt' => ['required', 'string', 'min:1', 'max:255'],
            'category' => ['required', 'in:Portrait,Landscape,Street,Wedding'],
            'orientation' => ['required', 'in:portrait,landscape'],
        ]);

        $imagePath = $request->file('image')->store('photos', 'public');

        try {
            $photo = Photo::create([
                'title' => $validated['title'],
                'alt' => $validated['alt'],
                'category' => $validated['category'],
                'orientation' => $validated['orientation'],
                'image_path' => $imagePath,
                'external_url' => null,
                'is_temporary' => false,
                'is_published' => false,
                'sort_order' => ((int) Photo::max('sort_order')) + 1,
            ]);
        } catch (\Throwable $exception) {
            Storage::disk('public')->delete($imagePath);
            throw $exception;
        }

        return response()->json([
            'message' => 'Photo uploaded successfully. It is currently unpublished.',
            'photo' => [
                'id' => $photo->id,
                'src' => Storage::disk('public')->url($photo->image_path),
                'title' => $photo->title,
                'alt' => $photo->alt,
                'category' => $photo->category,
                'orientation' => $photo->orientation,
                'is_temporary' => $photo->is_temporary,
                'is_published' => $photo->is_published,
                'sort_order' => $photo->sort_order,
            ],
        ], 201);
    }


    public function update(Request $request, Photo $photo): JsonResponse
    {
        $validated = $request->validate([
            'title' => ['sometimes', 'required', 'string', 'min:1', 'max:150'],
            'alt' => ['sometimes', 'required', 'string', 'min:1', 'max:255'],
            'category' => ['sometimes', 'required', 'in:Portrait,Landscape,Street,Wedding'],
            'orientation' => ['sometimes', 'required', 'in:portrait,landscape'],
            'is_published' => ['sometimes', 'boolean'],
            'sort_order' => ['sometimes', 'integer', 'min:0'],
        ]);

        $photo->update($validated);
        $photo->refresh();

        return response()->json([
            'message' => 'Photo updated successfully.',
            'photo' => [
                'id' => $photo->id,
                'src' => $photo->image_path
                    ? Storage::disk('public')->url($photo->image_path)
                    : $photo->external_url,
                'title' => $photo->title,
                'alt' => $photo->alt,
                'category' => $photo->category,
                'orientation' => $photo->orientation,
                'is_temporary' => $photo->is_temporary,
                'is_published' => $photo->is_published,
                'sort_order' => $photo->sort_order,
            ],
        ]);
    }


    public function replaceImage(Request $request, Photo $photo): JsonResponse
    {
        $validated = $request->validate([
            'image' => ['required', 'file', 'mimes:jpg,jpeg,png,webp', 'max:10240'],
        ]);

        $oldImagePath = $photo->image_path;
        $newImagePath = $request->file('image')->store('photos', 'public');

        try {
            $photo->update([
                'image_path' => $newImagePath,
                'external_url' => null,
                'is_temporary' => false,
            ]);
        } catch (\Throwable $exception) {
            Storage::disk('public')->delete($newImagePath);
            throw $exception;
        }

        if ($oldImagePath) {
            Storage::disk('public')->delete($oldImagePath);
        }

        $photo->refresh();

        return response()->json([
            'message' => 'Photo image replaced successfully.',
            'photo' => [
                'id' => $photo->id,
                'src' => Storage::disk('public')->url($photo->image_path),
                'title' => $photo->title,
                'alt' => $photo->alt,
                'category' => $photo->category,
                'orientation' => $photo->orientation,
                'is_temporary' => $photo->is_temporary,
                'is_published' => $photo->is_published,
                'sort_order' => $photo->sort_order,
            ],
        ]);
    }


    public function destroy(Photo $photo): JsonResponse
    {
        $imagePath = $photo->image_path;

        $photo->delete();

        if ($imagePath) {
            Storage::disk('public')->delete($imagePath);
        }

        return response()->json([
            'message' => 'Photo deleted successfully.',
        ]);
    }

}
